# Choose openai or ollama.
MODEL_PROVIDER=openai

# OpenAI is optional. Paid calls remain blocked until explicitly enabled.
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-5.4-mini
ALLOW_PAID_API_CALLS=false

# Ollama is optional and does not require an OpenAI key.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# Lab context limits.
INPUT_BUDGET_TOKENS=4000
OUTPUT_RESERVE_TOKENS=500
